# Mumble Murmur Ice Connection
MURMUR_ICE_HOST=mumble-server
MURMUR_ICE_PORT=6502
MURMUR_ICE_TIMEOUT=1000
ICE_SECRET=
ICE_MESSAGE_SIZE=1024

# Security (Leave API_KEY empty to disable authentication)
API_KEY=
MASK_PASSWORDS=true

# Environment (development, testing, production)
ENVIRONMENT=production

